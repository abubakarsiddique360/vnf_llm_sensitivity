# LLM API KEYS
# Replace these with your actual API keys in the .env file
OPENAI_API_KEY=sk-your-openai-api-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# EXPERIMENT CONFIGURATION
SEED=42
LLM_TEMPERATURE_PRIMARY=0.0
LLM_TEMPERATURE_SENSITIVITY=0.5
LLM_MAX_TOKENS_DEEPSEEK=2048
LLM_MAX_TOKENS_GPT=2048

# PATHS
PROBLEMS_DIR=data/problems
ILP_SOLUTIONS_DIR=data/ilp_solutions
PROMPTS_DIR=prompts
LLM_RESPONSES_DIR=data/llm_responses
PARSED_DIR=data/parsed
BASELINES_DIR=data/baselines
LOGS_DIR=logs